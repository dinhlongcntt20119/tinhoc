rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidSubmission(data) {
      return data.studentName is string && data.studentName.size() <= 100 &&
             data.studentClass is string && data.studentClass.size() <= 50 &&
             data.quizType is string && data.quizType.size() <= 64 &&
             data.schoolId is string && data.schoolId.size() <= 50 &&
             data.createdAt is string && data.createdAt.size() <= 40 &&
             (
               (data.quizType == 'ontaphk2' && data.keys().hasAll(['studentName', 'studentClass', 'quizType', 'score', 'total', 'answers', 'schoolId', 'createdAt']) && 
                data.score is number && data.total is number && data.answers is string && data.answers.size() <= 10000) ||
               (data.quizType == 'vbtontaphk2' && data.keys().hasAll(['studentName', 'studentClass', 'quizType', 'score', 'total', 'schoolId', 'createdAt']) && 
                data.score is number && data.total is number) ||
               (data.quizType == 'thuchanhhk2' && data.keys().hasAll(['studentName', 'studentClass', 'quizType', 'schoolId', 'createdAt']) && data.keys().size() == 5)
             );
    }

    function isValidQuizConfig(data) {
      return data.keys().hasAll(['shuffle', 'updatedAt']) &&
             data.keys().size() == 2 &&
             data.shuffle is bool &&
             data.updatedAt is string && data.updatedAt.size() <= 30;
    }

    match /submissions/{submissionId} {
      allow get, list, delete: if isSignedIn();
      allow create: if isValidId(submissionId) && isValidSubmission(incoming());
      allow update: if isSignedIn();
    }

    match /settings/{settingId} {
      allow get: if settingId == 'quizConfig';
      allow list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidQuizConfig(incoming());
    }

    match /admins/{uid} {
      allow read, write: if isSignedIn();
    }
  }
}
