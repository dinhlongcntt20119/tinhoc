rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'dinhlongcntt20119@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidSubmission(data) {
      return data.studentName is string && data.studentName.size() <= 100 &&
             data.studentClass is string && data.studentClass.size() <= 50 &&
             data.quizType is string && data.quizType.size() <= 64 &&
             data.schoolId is string && data.schoolId.size() <= 50 &&
             data.createdAt is string && data.createdAt.size() <= 40 &&
             (
               (data.quizType == 'ontaphk2' && data.keys().hasAll(['studentName', 'studentClass', 'quizType', 'score', 'total', 'answers', 'schoolId', 'createdAt']) && 
                data.score is number && data.total is number && data.answers is string && data.answers.size() <= 10000) ||
               (data.quizType == 'ontapk1hk2' && data.keys().hasAll(['studentName', 'studentClass', 'quizType', 'score', 'total', 'answers', 'schoolId', 'createdAt']) && 
                data.score is number && data.total is number && data.answers is string && data.answers.size() <= 10000) ||
               (data.quizType == 'ontapk2hk2' && data.keys().hasAll(['studentName', 'studentClass', 'quizType', 'score', 'total', 'answers', 'schoolId', 'createdAt']) && 
                data.score is number && data.total is number && data.answers is string && data.answers.size() <= 10000) ||
               (data.quizType == 'ontapk3hk2' && data.keys().hasAll(['studentName', 'studentClass', 'quizType', 'score', 'total', 'answers', 'schoolId', 'createdAt']) && 
                data.score is number && data.total is number && data.answers is string && data.answers.size() <= 10000) ||
               (data.quizType == 'ontapk5hk2' && data.keys().hasAll(['studentName', 'studentClass', 'quizType', 'score', 'total', 'answers', 'schoolId', 'createdAt']) && 
                data.score is number && data.total is number && data.answers is string && data.answers.size() <= 10000) ||
               (data.quizType == 'tuluank3hk2' && data.keys().hasAll(['studentName', 'studentClass', 'quizType', 'score', 'total', 'answers', 'schoolId', 'createdAt']) && 
                data.score is number && data.total is number && data.answers is string && data.answers.size() <= 10000) ||
               (data.quizType == 'thuchanhk5hk2' && data.keys().hasAll(['studentName', 'studentClass', 'quizType', 'schoolId', 'createdAt']) && data.keys().size() == 5) ||
               (data.quizType == 'vbtontaphk2' && data.keys().hasAll(['studentName', 'studentClass', 'quizType', 'score', 'total', 'submittedAt', 'schoolId', 'createdAt']) && 
                data.score is number && data.total is number && data.submittedAt is string && data.submittedAt.size() <= 100) ||
               (data.quizType == 'thuchanhhk2' && data.keys().hasAll(['studentName', 'studentClass', 'quizType', 'schoolId', 'createdAt']) && data.keys().size() == 5) ||
               (data.quizType == 'thik1hk2' && data.keys().hasAll(['studentName', 'studentClass', 'quizType', 'score', 'total', 'answers', 'schoolId', 'createdAt']) && 
                data.score is number && data.total is number && data.answers is string && data.answers.size() <= 10000) ||
               (data.quizType == 'thik2hk2' && data.keys().hasAll(['studentName', 'studentClass', 'quizType', 'score', 'total', 'answers', 'schoolId', 'createdAt']) && 
                data.score is number && data.total is number && data.answers is string && data.answers.size() <= 10000) ||
               (data.quizType == 'thik3hk2' && data.keys().hasAll(['studentName', 'studentClass', 'quizType', 'score', 'total', 'answers', 'schoolId', 'createdAt']) && 
                data.score is number && data.total is number && data.answers is string && data.answers.size() <= 10000) ||
               (data.quizType == 'thihk2' && data.keys().hasAll(['studentName', 'studentClass', 'quizType', 'score', 'total', 'answers', 'schoolId', 'createdAt']) && 
                data.score is number && data.total is number && data.answers is string && data.answers.size() <= 10000) ||
               (data.quizType == 'thik5hk2' && data.keys().hasAll(['studentName', 'studentClass', 'quizType', 'score', 'total', 'answers', 'schoolId', 'createdAt']) && 
                data.score is number && data.total is number && data.answers is string && data.answers.size() <= 10000)
             );
    }

    function isValidQuizConfig(data) {
      return data.keys().hasAll(['shuffle', 'updatedAt']) &&
             data.keys().size() == 2 &&
             data.shuffle is bool &&
             data.updatedAt is string && data.updatedAt.size() <= 30;
    }

    match /submissions/{submissionId} {
      allow get, list, delete, update: if isAdmin();
      allow create: if isValidId(submissionId) && isValidSubmission(incoming());
    }

    match /settings/{settingId} {
      allow get: if settingId == 'quizConfig' || settingId == 'adminAuth';
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read, write: if isSignedIn();
    }
  }
}
